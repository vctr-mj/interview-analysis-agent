# ==================================================
# CONFIGURACION DEL AGENTE DE ENTREVISTAS
# ==================================================
# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env al repositorio.

# --- Gemini (analisis con IA) ---
# API key gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=TU_API_KEY_AQUI

# Modelo de Gemini (default: gemini-2.5-flash)
# Opciones: gemini-2.5-flash | gemini-2.5-pro | gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# --- Whisper (transcripcion local) ---
# Tamano del modelo de Whisper que corre en tu maquina.
# Opciones (de menor a mayor calidad):
#   tiny   - Rapido, baja calidad (~1 GB RAM)
#   base   - Rapido, calidad aceptable (~1 GB RAM)
#   small  - Buen balance (~2 GB RAM)
#   medium - Alta calidad, mas lento (~5 GB RAM) [RECOMENDADO sin GPU]
#   large  - Maxima calidad, lento (~10 GB VRAM, requiere GPU)
#   turbo  - Maxima calidad, rapido (~6 GB VRAM) [RECOMENDADO con GPU]
#
# Con GPU NVIDIA: usa "turbo" (requiere instalar PyTorch con CUDA, ver README)
# Sin GPU:        usa "medium"
WHISPER_MODEL_SIZE=medium

# --- Carpeta de grabaciones ---
# Ruta absoluta a la carpeta con tus grabaciones de entrevistas
INTERVIEWS_FOLDER=/ruta/absoluta/a/tu/carpeta/de/entrevistas

# --- LinkedIn (opcional) ---
# Zona horaria para calcular horarios optimos de publicacion
LINKEDIN_TIMEZONE=America/Mexico_City
