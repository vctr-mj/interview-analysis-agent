# ==================================================
# ARCHIVOS SENSIBLES - NUNCA SUBIR AL REPOSITORIO
# ==================================================

# Variables de entorno (contiene API keys)
.env

# Credenciales de Google / cualquier servicio
*.json
!package.json
!package-lock.json

# ==================================================
# DATOS GENERADOS / PERSONALES
# ==================================================

# Output del agente (datos personales de entrevistas)
output/

# Logs y apuntes
*.log
apuntes.txt

# Grabaciones de entrevistas
*.mkv
*.mp4
*.mov
*.avi
*.mp3
*.wav

# ==================================================
# PYTHON
# ==================================================

# Entorno virtual
venv/
.venv/
env/

# Cache de Python
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribuciones
*.egg-info/
dist/
build/

